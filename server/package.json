{
  "name": "@aquaveda/server",
  "version": "0.1.0",
  "private": true,
  "description": "AquaVeda v2 — Express API service",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:users": "node src/seed/seedUsers.js",
    "verify:models": "node scripts/verify-models.js",
    "verify:validation": "node scripts/verify-validation.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "zod": "^3.23.8"
  }
}
