# =============================================================================
# AquaVeda Server — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit .env with real secrets to version control.
# =============================================================================

# ---- Process / Runtime ------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---- Database ---------------------------------------------------------------
# Application MongoDB connection string.
# In local development, loopback host (127.0.0.1 / localhost) is recommended.
MONGO_URI=mongodb://127.0.0.1:27017/aquaveda_v2_dev

# Test database connection string (required for npm test against real MongoDB).
# If left unset, npm test automatically starts an in-process MongoMemoryServer.
# When provided, TEST_MONGO_URI must differ from MONGO_URI and must not target
# a database ending with "_dev".
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/aquaveda_v2_test

# ---- CORS / Cookies ---------------------------------------------------------
# Comma-separated list of allowed origins for credentialed cross-origin requests.
# In production, this must be explicitly set and must never include "*".
ALLOWED_ORIGINS=http://localhost:3000

# Cookie SameSite attribute (strict, lax, none).
# Topology is locked to genuine cross-site deployment, requiring "none".
COOKIE_SAME_SITE=none

# Cookie Domain attribute (leave unset for host-only cookies).
# In cross-site deployments, Domain attribute should remain unset.
# COOKIE_DOMAIN=

# ---- JWT Secrets & Lifetimes ------------------------------------------------
# Split cryptographic keys: access and refresh tokens MUST use distinct secrets.
# In production, secrets must be at least 32 characters long and have high entropy.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or: openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-example
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-example

# Token expiration durations (syntax: <number>[s|m|h|d], e.g. 15m, 7d).
# JWT_ACCESS_EXPIRES must be strictly shorter than JWT_REFRESH_EXPIRES.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Local ADMIN Provisioning (Development Only) ----------------------------
# Optional tool (npm run provision:admin) to bootstrap a local admin for testing.
# Fails closed if NODE_ENV=production or if MONGO_URI is not local *_dev.
# ALLOW_DEV_ADMIN_PROVISIONING=true
# ADMIN_BOOTSTRAP_EMAIL=admin@example.test
# ADMIN_BOOTSTRAP_PASSWORD=local-admin-password-min-8-chars
# ADMIN_BOOTSTRAP_NAME=Local Admin
