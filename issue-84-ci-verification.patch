@@ -0,0 +1,69 @@
+name: CI
+
+# Runs the repo's own verification scripts; no logic is duplicated here.
+#   frontend -> npm run verify:frontend  (test, lint, typecheck, build)
+#   backend  -> npm --prefix server run verify  (needs real MongoDB)
+# Together they cover the frontend/backend verification commands invoked by
+# root `npm run verify`.
+on:
+  pull_request:
+    branches: [main]
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  NODE_VERSION: "22"
+
+jobs:
+  frontend:
+    name: Frontend (test, lint, typecheck, build)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: ${{ env.NODE_VERSION }}
+          cache: npm
+          cache-dependency-path: package-lock.json
+      - run: npm ci
+      # next/font/google fetches fonts at build time; hosted runners have network access.
+      - run: npm run verify:frontend
+
+  backend:
+    name: Backend (tests, verify scripts; MongoDB)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    services:
+      mongo:
+        # Major-pinned (not `latest`). No project-stated server version exists;
+        # see docs/engineering/testing.md ("CI") for rationale.
+        image: mongo:7
+        ports:
+          - 27017:27017
+        options: >-
+          --health-cmd "mongosh --quiet --eval 'db.adminCommand({ping:1})'"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 12
+    env:
+      # Test-only values. TEST_MONGO_URI must differ from MONGO_URI (unset here).
+      TEST_MONGO_URI: mongodb://127.0.0.1:27017/aquaveda_v2_test
+      JWT_ACCESS_SECRET: ci-only-access-secret-not-for-production-0001
+      JWT_REFRESH_SECRET: ci-only-refresh-secret-not-for-production-0002
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: ${{ env.NODE_VERSION }}
+          cache: npm
+          cache-dependency-path: server/package-lock.json
+      - run: npm ci --prefix server
+      - run: npm --prefix server run verify
